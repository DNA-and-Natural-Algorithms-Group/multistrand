# Multistrand nucleic acid kinetic simulator
# Copyright (c) 2008-2025 California Institute of Technology. All rights reserved.
# The Multistrand Team (help@multistrand.org)

Bootstrap: docker
From: ghcr.io/astral-sh/uv:debian-slim

%help
    This Apptainer container provides the NUPACK [1] and Multistrand [2]
    simulators, in a Python environment managed by `uv`. The container build
    script requires the NUPACK release archive and the Multistrand source tree
    to be available on the host system.

    [1] https://github.com/DNA-and-Natural-Algorithms-Group/multistrand
    [2] https://www.nupack.org/

%arguments
    NU_VER=4.0.2.0

%files
    ../../nupack-{{NU_VER}}.zip /dna/
    ../../multistrand/pyproject.toml /dna/multistrand/
    ../../multistrand/setup.py /dna/multistrand/
    ../../multistrand/src /dna/multistrand/
    ../../multistrand/test /dna/multistrand/
    ../../multistrand/tutorials /dna/multistrand/

%environment
    export UV_PROJECT_ENVIRONMENT=/dna/multistrand/.venv
    export PATH="$UV_PROJECT_ENVIRONMENT/bin:$PATH" \
           VIRTUAL_ENV=$UV_PROJECT_ENVIRONMENT
    export UV_LOCKED=1 UV_NO_CACHE=1 UV_LINK_MODE=copy \
           UV_PYTHON_PREFERENCE=only-managed UV_COMPILE_BYTECODE=1

%post
    chmod 1777 /tmp
    apt-get update
    apt-get install \
        -y --no-install-recommends \
        ca-certificates curl unzip tar bat tree git build-essential
    apt-get clean

    # configure Python package manager
    echo "\n\n\n"
    export UV_NO_CACHE=1 UV_LINK_MODE=copy \
           UV_PYTHON_PREFERENCE=only-managed UV_COMPILE_BYTECODE=1

    # install NUPACK & Multistrand
    cd /dna && unzip -q nupack-{{NU_VER}}.zip
    cd /dna/multistrand
    find . -type f -regex ".*\.so" -print | xargs rm -v
    echo "\n\n\n"
    uv sync -v --extra testing --extra tutorials

    # install Python utils
    echo "\n\n\n"
    uv add ipython jupyter

    # cleanup
    echo "\n\n\n"
    cd /dna && rm -r nupack-{{NU_VER}}.zip nupack-{{NU_VER}}

%test
    echo "\n\n\n"
    cd /dna/multistrand
    # at build time: skip tests relying on file system output
    pytest --override-ini cache_dir=/tmp/pytest \
           -k "not Inspector and not Determinism and not Equilibrium and not Dissoc"

%labels
    Author Boyan Beronov, Jordan Lovrod, Chenwei Zhang, Jake Kaslewicz
