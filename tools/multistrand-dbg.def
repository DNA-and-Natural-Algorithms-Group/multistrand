# Multistrand nucleic acid kinetic simulator
# Copyright (c) 2008-2025 California Institute of Technology. All rights reserved.
# The Multistrand Team (help@multistrand.org)

Bootstrap: docker
From: bitnami/minideb:bookworm

%help
    This Apptainer container provides NUPACK 4.0 [1] and a debug build of
    Multistrand 2.2 [2], in a Python environment managed by `pip`. Both
    libraries are installed on a debug build of Python, which is additionally
    configured to interoperate with GDB and Valgrind. See [3] for a tutorial on
    using GDB for the Python runtime and its C extensions, and similarly [4] for
    Valgrind.

    The container build script requires the NUPACK release archive and the
    Multistrand source tree to be available on the host system.

    [1] https://www.nupack.org/
    [2] https://github.com/DNA-and-Natural-Algorithms-Group/multistrand
    [3] https://willayd.com/fundamental-python-debugging-part-2-python-extensions.html
    [4] https://pythonextensionpatterns.readthedocs.io/en/latest/debugging/valgrind.html

%arguments
    # version config
    NU_VER=4.0.2.0
    CPY_VER=3.13
    CPY_TAG=5
    GDB_VER=16.3
    # compiler config
    NJOBS=8

%files
    ../../nupack-{{NU_VER}}.zip /dna/
    ../../multistrand/pyproject.toml /dna/multistrand/
    ../../multistrand/setup.py /dna/multistrand/
    ../../multistrand/src /dna/multistrand/
    ../../multistrand/test /dna/multistrand/
    ../../multistrand/tutorials /dna/multistrand/
    ../../multistrand/tools/valgrind-python.awk /dna/multistrand/tools/

%environment
    export PATH=/usr/local/bin:${PATH}

%post
    # bin paths
    export PATH=/usr/local/bin:${PATH}
    # build paths
    export BLD_ROOT=/build
    export GDB_TAR=gdb-{{GDB_VER}}.tar.gz GDB_SRC=${BLD_ROOT}/gdb-{{GDB_VER}}
    export GDB_DATA=/usr/local/share/gdb
    export CPY_SRC=${BLD_ROOT}/cpython
    # lib paths
    export LIB_ROOT=/dna
    export NU_SRC=${LIB_ROOT}/nupack-{{NU_VER}}
    export NU_ZIP=${NU_SRC}.zip
    export MS=${LIB_ROOT}/multistrand

    # install common system utils
    # (`install_packages`: wrapper for APT provided by Bitnami base image)
    install_packages \
        sudo ca-certificates build-essential pkgconf wget curl unzip tar \
        bat tree git time gawk vim valgrind

    # install Python from source, configured with PDB & Valgrind
    install_packages \
        libbz2-dev libffi-dev libssl-dev zlib1g-dev liblzma-dev \
        libsqlite3-dev libreadline-dev libgmp-dev libmpfr-dev
    echo "\n\n\n"
    git clone -b v{{CPY_VER}}.{{CPY_TAG}} --depth 1 \
        https://github.com/python/cpython.git ${CPY_SRC}
    cd ${CPY_SRC}
    ./configure --with-pydebug --without-pymalloc --with-valgrind
    CFLAGS='-g3' make -s -j{{NJOBS}} && sudo make install

    # info
    echo "\n\n\n" && pip3 debug

    # tweak Valgrind suppression file for Python
    cd ${MS}/tools && sudo gawk -f valgrind-python.awk \
        ${CPY_SRC}/Misc/valgrind-python.supp > valgrind-python.supp

    # install GDB from source, configured with Python
    echo "\n\n\n"
    cd ${BLD_ROOT} && wget --wait=10 https://ftp.gnu.org/gnu/gdb/${GDB_TAR}
    tar -xzf ${GDB_TAR} && cd ${GDB_SRC}
    ./configure --with-python=python{{CPY_VER}}
    make -s -j{{NJOBS}} && sudo make install
    # auto-import Python intrinsics in GDB
    sudo cp ${CPY_SRC}/Tools/gdb/libpython.py ${GDB_DATA}/python/gdb/function

    # install Python utils
    pip3 install ipython

    # install NUPACK
    echo "\n\n\n"
    cd ${LIB_ROOT} && unzip -q ${NU_ZIP}
    pip3 install -U nupack -f ${NU_SRC}/package

    # install Multistrand, configured with debugging compiler flags
    echo "\n\n\n" && cd ${MS}
    find . -type f -regex ".*\.so" -print | xargs rm -v
    sed --in-place "s/^\(debug = \)\w*$/\1True/" setup.py
    pip3 install -v -e .[tutorials] --group dev

    # info
    echo "\n\n\n" && pip3 list

    # cleanup
    echo "\n\n\n"
    rm -r ${CPY_SRC} ${BLD_ROOT}/${GDB_TAR} ${GDB_SRC} ${NU_ZIP} ${NU_SRC}
    pip3 cache purge

%labels
    Author Boyan Beronov, Jordan Lovrod, Chenwei Zhang, Jake Kaslewicz
